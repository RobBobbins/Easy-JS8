<?xml version="1.0" encoding="utf-8"?>
<EditText xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/js8_typing_box"
    style="@style/Js8Text"
    android:layout_width="match_parent"
    android:layout_height="67dp"
    android:background="@color/js8_typing_box"
    android:gravity="top|start"
    android:hint="TYPE YOUR OUTGOING MESSAGES HERE."
    android:importantForAutofill="no"
    android:inputType="textMultiLine|textCapCharacters|textNoSuggestions"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:textColorHint="@color/js8_typing_hint" />
