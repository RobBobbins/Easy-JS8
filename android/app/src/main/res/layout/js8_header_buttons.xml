<?xml version="1.0" encoding="utf-8"?>
<!-- Header right (Rob, 2026-10-31): RX TX mode / SPOT LOG Settings TUNE. The mode button holds the
     PC's mode text and spans Settings and TUNE; its size never changes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/js8_btn_rx"
                style="@style/Js8HeaderToggleGreen"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="RX" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/js8_btn_tx"
                style="@style/Js8HeaderToggleGreen"
                android:layout_width="0dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="TX" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/js8_btn_spot"
                style="@style/Js8HeaderToggleBlue"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textStyle="bold"
                android:text="SPOT" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/js8_btn_log"
                style="@style/Js8HeaderToggleBlue"
                android:layout_width="0dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="LOG" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/js8_btn_mode"
            style="@style/Js8HeaderModeButton"
            android:layout_width="match_parent"
            android:autoSizeMaxTextSize="14.3dp"
            android:autoSizeMinTextSize="6dp"
            android:autoSizeStepGranularity="0.5dp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="false"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="NORMAL+MULTI" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/js8_btn_settings"
                style="@style/Js8HeaderModeButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="14.3dp"
                android:autoSizeMinTextSize="8dp"
                android:autoSizeStepGranularity="0.5dp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="false"
                android:text="Settings" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/js8_btn_tune"
                style="@style/Js8HeaderToggleBlue"
                android:layout_width="0dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="TUNE" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
