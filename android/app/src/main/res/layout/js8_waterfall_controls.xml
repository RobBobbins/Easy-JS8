<?xml version="1.0" encoding="utf-8"?>
<!-- Waterfall Controls: Control / Display / Timing tabs (JS8_UI/WideGraph.ui). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/js8_wf_tab_control"
            style="@style/Js8FrameText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/js8_tab_selected"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Control" />

        <TextView
            android:id="@+id/js8_wf_tab_display"
            style="@style/Js8FrameText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:text="Display" />

        <TextView
            android:id="@+id/js8_wf_tab_timing"
            style="@style/Js8FrameText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:text="Timing" />
    </LinearLayout>

    <!-- Control tab (WideGraph.ui, Rob's capture 2026-10-20): spin boxes with ∧ ∨, QSY, filter
         with Sync and two knobs. Wired in Js8WaterfallControls.kt. -->
    <LinearLayout
        android:id="@+id/js8_wf_control_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/js8_groupbox"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Offset group: hidden upright, where Offset lives in the Settings window -->
        <TextView android:id="@+id/js8_wf_offset_title" style="@style/Js8GroupTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Offset" />
        <LinearLayout android:id="@+id/js8_wf_offset_box" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/js8_groupbox" android:padding="8dp">
            <LinearLayout android:id="@+id/js8_wf_offset_spin" android:layout_width="match_parent" android:layout_height="30dp"
                android:background="@drawable/js8_spin_field" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/js8_wf_offset" style="@style/Js8FrameText" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="none" android:gravity="center_vertical"
                    android:paddingStart="8dp" android:singleLine="true" android:text="Offset: 1500 Hz" />
                <TextView android:id="@+id/js8_wf_offset_up" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:gravity="center" android:text="∧" />
                <TextView android:id="@+id/js8_wf_offset_down" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:layout_marginEnd="4dp" android:gravity="center" android:text="∨" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/Js8GroupTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="QSY" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/js8_groupbox" android:orientation="vertical" android:padding="8dp">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/js8_wf_qsy"
                style="@style/Js8Button" android:layout_width="match_parent" android:text="QSY" />
            <LinearLayout android:id="@+id/js8_wf_center_box" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="8dp"
                android:background="@drawable/js8_spin_field" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/js8_wf_center" style="@style/Js8FrameText" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="none" android:gravity="center_vertical"
                    android:paddingStart="8dp" android:singleLine="true" android:text="Center: 1500 Hz" />
                <TextView android:id="@+id/js8_wf_center_up" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:gravity="center" android:text="∧" />
                <TextView android:id="@+id/js8_wf_center_down" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:layout_marginEnd="4dp" android:gravity="center" android:text="∨" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/Js8GroupTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Filter" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/js8_groupbox" android:orientation="vertical" android:padding="8dp">
            <LinearLayout android:id="@+id/js8_wf_filter_row" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal">
                <CheckBox android:id="@+id/js8_wf_filter_enable" style="@style/Js8FrameText"
                    android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1"
                    android:singleLine="true" android:text="Enable Filter" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/js8_wf_filter_sync"
                    style="@style/Js8Button" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_marginStart="8dp" android:text="Sync" />
            </LinearLayout>
            <LinearLayout android:id="@+id/js8_wf_filter_boxes_row" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:baselineAligned="false" android:orientation="horizontal">
                <LinearLayout android:id="@+id/js8_wf_filter_center_col" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:gravity="center_horizontal" android:orientation="vertical">
                    <LinearLayout android:id="@+id/js8_wf_filter_center_box" android:layout_width="match_parent" android:layout_height="30dp"
                android:background="@drawable/js8_spin_field" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/js8_wf_filter_center" style="@style/Js8FrameText" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="none" android:gravity="center_vertical"
                    android:paddingStart="8dp" android:singleLine="true" android:text="Center: 1500 Hz" />
                <TextView android:id="@+id/js8_wf_filter_center_up" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:gravity="center" android:text="∧" />
                <TextView android:id="@+id/js8_wf_filter_center_down" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:layout_marginEnd="4dp" android:gravity="center" android:text="∨" />
            </LinearLayout>
                    <com.js8call.example.js8ui.Js8KnobView android:id="@+id/js8_wf_filter_center_knob"
                        android:layout_width="64dp" android:layout_height="64dp" android:layout_marginTop="10dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/js8_wf_filter_width_col" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="8dp" android:gravity="center_horizontal" android:orientation="vertical">
                    <LinearLayout android:id="@+id/js8_wf_filter_width_box" android:layout_width="match_parent" android:layout_height="30dp"
                android:background="@drawable/js8_spin_field" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/js8_wf_filter_width" style="@style/Js8FrameText" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="none" android:gravity="center_vertical"
                    android:paddingStart="8dp" android:singleLine="true" android:text="Width: 2000 Hz" />
                <TextView android:id="@+id/js8_wf_filter_width_up" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:gravity="center" android:text="∧" />
                <TextView android:id="@+id/js8_wf_filter_width_down" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:layout_marginEnd="4dp" android:gravity="center" android:text="∨" />
            </LinearLayout>
                    <com.js8call.example.js8ui.Js8KnobView android:id="@+id/js8_wf_filter_width_knob"
                        android:layout_width="64dp" android:layout_height="64dp" android:layout_marginTop="10dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Display tab (WideGraph.ui displayTab), first part: Size, Palette, Scroll Speed + Flatten,
         Waterfall Gain / Zero, Filter Opacity. Wired in Js8WaterfallDisplay.kt. -->
    <LinearLayout
        android:id="@+id/js8_wf_display_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/js8_groupbox"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">
        <TextView style="@style/Js8GroupTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Size" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/js8_groupbox" android:orientation="vertical" android:padding="8dp">
            <LinearLayout android:id="@+id/js8_wf_start_box" android:layout_width="match_parent" android:layout_height="30dp"
                android:background="@drawable/js8_spin_field" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/js8_wf_start" style="@style/Js8FrameText" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="none" android:gravity="center_vertical"
                    android:paddingStart="8dp" android:singleLine="true" android:text="Start: 500 Hz" />
                <TextView android:id="@+id/js8_wf_start_up" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:gravity="center" android:text="∧" />
                <TextView android:id="@+id/js8_wf_start_down" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:layout_marginEnd="4dp" android:gravity="center" android:text="∨" />
            </LinearLayout>
            <LinearLayout android:id="@+id/js8_wf_bpp_box" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="6dp"
                android:background="@drawable/js8_spin_field" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/js8_wf_bpp" style="@style/Js8FrameText" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="none" android:gravity="center_vertical"
                    android:paddingStart="8dp" android:singleLine="true" android:text="Bins Per Pixel: 2" />
                <TextView android:id="@+id/js8_wf_bpp_up" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:gravity="center" android:text="∧" />
                <TextView android:id="@+id/js8_wf_bpp_down" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:layout_marginEnd="4dp" android:gravity="center" android:text="∨" />
            </LinearLayout>
        </LinearLayout>
        <TextView style="@style/Js8GroupTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Palette" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/js8_groupbox" android:orientation="vertical" android:padding="8dp">
            <TextView android:id="@+id/js8_wf_palette" style="@style/Js8FrameText" android:layout_width="match_parent"
                android:layout_height="30dp" android:background="@drawable/js8_spin_field"
                android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp"
                android:singleLine="true" android:text="Default  ▾" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/js8_wf_palette_adjust"
                style="@style/Js8Button" android:layout_width="match_parent" android:layout_marginTop="6dp"
                android:text="Adjust..." />
        </LinearLayout>
        <TextView style="@style/Js8GroupTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Scrolling &amp; Averaging" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/js8_groupbox" android:orientation="vertical" android:padding="8dp">
            <LinearLayout android:id="@+id/js8_wf_fps_box" android:layout_width="match_parent" android:layout_height="30dp"
                android:background="@drawable/js8_spin_field" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/js8_wf_fps" style="@style/Js8FrameText" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="none" android:gravity="center_vertical"
                    android:paddingStart="8dp" android:singleLine="true" android:text="Scroll Speed: 4 fps" />
                <TextView android:id="@+id/js8_wf_fps_up" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:gravity="center" android:text="∧" />
                <TextView android:id="@+id/js8_wf_fps_down" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:layout_marginEnd="4dp" android:gravity="center" android:text="∨" />
            </LinearLayout>
            <LinearLayout android:id="@+id/js8_wf_avg_row" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:baselineAligned="false" android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout android:id="@+id/js8_wf_avg_box" android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1"
                android:background="@drawable/js8_spin_field" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/js8_wf_avg" style="@style/Js8FrameText" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="none" android:gravity="center_vertical"
                    android:paddingStart="8dp" android:singleLine="true" android:text="Avg N: 1" />
                <TextView android:id="@+id/js8_wf_avg_up" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:gravity="center" android:text="∧" />
                <TextView android:id="@+id/js8_wf_avg_down" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:layout_marginEnd="4dp" android:gravity="center" android:text="∨" />
            </LinearLayout>
                <CheckBox android:id="@+id/js8_wf_flatten" style="@style/Js8FrameText"
                    android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="8dp"
                    android:singleLine="true" android:text="Flatten" />
            </LinearLayout>
            <TextView android:id="@+id/js8_wf_spectrum" style="@style/Js8FrameText" android:layout_width="match_parent"
                android:layout_height="30dp" android:layout_marginTop="6dp" android:background="@drawable/js8_spin_field"
                android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp"
                android:singleLine="true" android:text="Current  ▾" />
            <LinearLayout android:id="@+id/js8_wf_smooth_box" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="6dp"
                android:background="@drawable/js8_spin_field" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/js8_wf_smooth" style="@style/Js8FrameText" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="none" android:gravity="center_vertical"
                    android:paddingStart="8dp" android:singleLine="true" android:text="Smooth:  1" />
                <TextView android:id="@+id/js8_wf_smooth_up" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:gravity="center" android:text="∧" />
                <TextView android:id="@+id/js8_wf_smooth_down" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:layout_marginEnd="4dp" android:gravity="center" android:text="∨" />
            </LinearLayout>
        </LinearLayout>
        <TextView style="@style/Js8GroupTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Waterfall" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/js8_groupbox" android:orientation="vertical" android:padding="8dp">
            <LinearLayout android:id="@+id/js8_wf_gain_row" android:layout_width="match_parent" android:layout_height="30dp"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView style="@style/Js8FrameText" android:layout_width="56dp" android:layout_height="wrap_content"
                    android:singleLine="true" android:text="Gain:" />
                <SeekBar android:id="@+id/js8_wf_gain" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1"
                    android:max="100" android:progress="50" android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:progressDrawable="@drawable/js8_slider_track" android:splitTrack="false"
                    android:thumb="@drawable/js8_slider_thumb" android:thumbOffset="8dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/js8_wf_zero_row" android:layout_width="match_parent" android:layout_height="30dp"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView style="@style/Js8FrameText" android:layout_width="56dp" android:layout_height="wrap_content"
                    android:singleLine="true" android:text="Zero:" />
                <SeekBar android:id="@+id/js8_wf_zero" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1"
                    android:max="100" android:progress="50" android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:progressDrawable="@drawable/js8_slider_track" android:splitTrack="false"
                    android:thumb="@drawable/js8_slider_thumb" android:thumbOffset="8dp" />
            </LinearLayout>
            <CheckBox android:id="@+id/js8_wf_decode_attempts" style="@style/Js8FrameText"
                android:layout_width="wrap_content" android:layout_height="30dp"
                android:singleLine="true" android:text="Display Decode Attempts" />
        </LinearLayout>
        <TextView style="@style/Js8GroupTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Spectrum" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/js8_groupbox" android:orientation="vertical" android:padding="8dp">
            <LinearLayout android:id="@+id/js8_wf_height_row" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView style="@style/Js8FrameText" android:layout_width="56dp" android:layout_height="wrap_content"
                    android:singleLine="true" android:text="Height:" />
                <LinearLayout android:id="@+id/js8_wf_height_box" android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1"
                android:background="@drawable/js8_spin_field" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/js8_wf_height" style="@style/Js8FrameText" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="none" android:gravity="center_vertical"
                    android:paddingStart="8dp" android:singleLine="true" android:text="0 %" />
                <TextView android:id="@+id/js8_wf_height_up" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:gravity="center" android:text="∧" />
                <TextView android:id="@+id/js8_wf_height_down" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:layout_marginEnd="4dp" android:gravity="center" android:text="∨" />
            </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/js8_wf_gain2d_row" android:layout_width="match_parent" android:layout_height="30dp"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView style="@style/Js8FrameText" android:layout_width="56dp" android:layout_height="wrap_content"
                    android:singleLine="true" android:text="Gain:" />
                <SeekBar android:id="@+id/js8_wf_gain2d" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1"
                    android:max="100" android:progress="50" android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:progressDrawable="@drawable/js8_slider_track" android:splitTrack="false"
                    android:thumb="@drawable/js8_slider_thumb" android:thumbOffset="8dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/js8_wf_zero2d_row" android:layout_width="match_parent" android:layout_height="30dp"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView style="@style/Js8FrameText" android:layout_width="56dp" android:layout_height="wrap_content"
                    android:singleLine="true" android:text="Zero:" />
                <SeekBar android:id="@+id/js8_wf_zero2d" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1"
                    android:max="100" android:progress="50" android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:progressDrawable="@drawable/js8_slider_track" android:splitTrack="false"
                    android:thumb="@drawable/js8_slider_thumb" android:thumbOffset="8dp" />
            </LinearLayout>
        </LinearLayout>
        <TextView style="@style/Js8GroupTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Filter" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/js8_groupbox" android:orientation="vertical" android:padding="8dp">
            <LinearLayout android:id="@+id/js8_wf_opacity_row" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView style="@style/Js8FrameText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp" android:singleLine="true" android:text="Opacity:" />
                <LinearLayout android:id="@+id/js8_wf_opacity_box" android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1"
                android:background="@drawable/js8_spin_field" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/js8_wf_opacity" style="@style/Js8FrameText" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="none" android:gravity="center_vertical"
                    android:paddingStart="8dp" android:singleLine="true" android:text="50%" />
                <TextView android:id="@+id/js8_wf_opacity_up" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:gravity="center" android:text="∧" />
                <TextView android:id="@+id/js8_wf_opacity_down" style="@style/Js8FrameText" android:layout_width="18dp"
                    android:layout_height="match_parent" android:layout_marginEnd="4dp" android:gravity="center" android:text="∨" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Timing tab (WideGraph.ui timingTab): Time Drift box, Automatic and Manual groups.
         Wired in Js8WaterfallControls.kt. -->
    <LinearLayout
        android:id="@+id/js8_wf_timing_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/js8_groupbox"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout android:id="@+id/js8_wf_drift_box" android:layout_width="match_parent" android:layout_height="30dp"
            android:background="@drawable/js8_spin_field" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/js8_wf_drift" style="@style/Js8FrameText" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="none" android:gravity="center"
                android:paddingStart="8dp" android:singleLine="true" android:text="Time Drift: 0 ms" />
            <TextView android:id="@+id/js8_wf_drift_up" style="@style/Js8FrameText" android:layout_width="18dp"
                android:layout_height="match_parent" android:gravity="center" android:text="∧" />
            <TextView android:id="@+id/js8_wf_drift_down" style="@style/Js8FrameText" android:layout_width="18dp"
                android:layout_height="match_parent" android:layout_marginEnd="4dp" android:gravity="center" android:text="∨" />
        </LinearLayout>

        <TextView style="@style/Js8GroupTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Automatic" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/js8_groupbox" android:orientation="vertical" android:padding="8dp">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/js8_wf_auto_drift"
                style="@style/Js8Button" android:layout_width="match_parent" android:singleLine="true"
                android:text="Start Automatic Time Drift" />
            <LinearLayout android:id="@+id/js8_wf_auto_drift_row" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:baselineAligned="false" android:gravity="center_vertical"
                android:orientation="horizontal">
                <CheckBox android:id="@+id/js8_wf_auto_drift_stop" style="@style/Js8FrameText"
                    android:layout_width="wrap_content" android:layout_height="30dp"
                    android:singleLine="true" android:text="Stop After:" />
                <LinearLayout android:id="@+id/js8_wf_auto_drift_count_box" android:layout_width="0dp" android:layout_height="30dp"
                    android:layout_weight="1" android:layout_marginStart="4dp"
                    android:background="@drawable/js8_spin_field" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/js8_wf_auto_drift_count" style="@style/Js8FrameText" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="none" android:gravity="center_vertical"
                        android:paddingStart="8dp" android:singleLine="true" android:text="1 decode(s)" />
                    <TextView android:id="@+id/js8_wf_auto_drift_count_up" style="@style/Js8FrameText" android:layout_width="18dp"
                        android:layout_height="match_parent" android:gravity="center" android:text="∧" />
                    <TextView android:id="@+id/js8_wf_auto_drift_count_down" style="@style/Js8FrameText" android:layout_width="18dp"
                        android:layout_height="match_parent" android:layout_marginEnd="4dp" android:gravity="center" android:text="∨" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/Js8GroupTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Manual" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/js8_groupbox" android:orientation="vertical" android:padding="8dp">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/js8_wf_drift_minute"
                style="@style/Js8Button" android:layout_width="match_parent" android:singleLine="false" android:maxLines="1"
                app:autoSizeTextType="uniform" app:autoSizeMinTextSize="9dp" app:autoSizeMaxTextSize="14.3dp"
                app:autoSizeStepGranularity="0.5dp"
                android:text="Set Time Drift to Now (Minute Start)" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/js8_wf_drift_end"
                style="@style/Js8Button" android:layout_width="match_parent" android:layout_marginTop="6dp"
                android:singleLine="true" android:text="Set Time Drift to Now (TX End)" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/js8_wf_drift_start"
                style="@style/Js8Button" android:layout_width="match_parent" android:layout_marginTop="6dp"
                android:singleLine="true" android:text="Set Time Drift to Now (TX Start)" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/js8_wf_drift_reset"
                style="@style/Js8Button" android:layout_width="match_parent" android:layout_marginTop="6dp"
                android:singleLine="true" android:text="Reset Time Drift" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
