<?xml version="1.0" encoding="utf-8"?>
<!-- FT8Call layout Status Bar (Rob, 2026-10-20; FT8Call v0.4.2 order): Receiving | JS8 Normal |
     Last Tx (plain text, not filled yet) | long cycle progress bar | wpm. Freq and Auto Reply are
     not in FT8Call's bar; they stay here hidden because Js8MainFragment updates them. -->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/js8_status_state"
            style="@style/Js8StatusLabel"
            android:layout_width="120dp"
            android:background="@drawable/js8_status_green"
            android:text="Receiving" />

        <TextView
            android:id="@+id/js8_status_mode"
            style="@style/Js8StatusLabel"
            android:layout_width="wrap_content"
            android:layout_marginStart="6dp"
            android:text="JS8 Normal" />

        <!-- PC Last Tx (not filled yet) -->
        <TextView
            android:id="@+id/js8_status_blank"
            style="@style/Js8FrameText"
            android:layout_width="160dp"
            android:layout_height="22dp"
            android:layout_marginStart="6dp"
            android:gravity="center_vertical"
            android:singleLine="true" />

        <com.js8call.example.js8ui.Js8CycleProgressView
            android:id="@+id/js8_status_progress"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1" />

        <!-- PC wpm_label, hidden while the Typing Box is empty -->
        <TextView
            android:id="@+id/js8_status_wpm"
            style="@style/Js8StatusLabel"
            android:layout_width="150dp"
            android:layout_marginStart="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/js8_status_freq"
            style="@style/Js8StatusLabel"
            android:layout_width="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/js8_status_autoreply"
            style="@style/Js8StatusLabel"
            android:layout_width="wrap_content"
            android:visibility="gone" />

        <!-- Room for the PC window's resize grip -->
        <View
            android:layout_width="22dp"
            android:layout_height="1dp" />
    </LinearLayout>
</HorizontalScrollView>
