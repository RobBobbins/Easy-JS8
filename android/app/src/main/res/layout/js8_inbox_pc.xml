<?xml version="1.0" encoding="utf-8"?>
<!-- Inbox as the narrow "Message Inbox" dock on the right edge of the PC window. Same ids as js8_inbox. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        style="@style/Js8FrameText"
        android:layout_width="match_parent"
        android:layout_height="27dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:singleLine="true"
        android:text="Message Inbox" />

    <com.js8call.example.js8ui.Js8TableView
        android:id="@+id/js8_inbox_table"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="317" />

    <TextView
        android:id="@+id/js8_inbox_message"
        style="@style/Js8Text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="120"
        android:background="@drawable/js8_panel_list"
        android:gravity="top|start"
        android:padding="5dp" />

    <EditText
        android:id="@+id/js8_inbox_reply_text"
        style="@style/Js8Text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="110"
        android:background="@drawable/js8_panel_list"
        android:gravity="top|start"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapCharacters|textNoSuggestions"
        android:padding="5dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/js8_inbox_reply"
        style="@style/Js8Button"
        android:layout_width="54dp"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:text="Reply" />
</LinearLayout>
