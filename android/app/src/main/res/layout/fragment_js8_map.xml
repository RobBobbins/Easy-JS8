<?xml version="1.0" encoding="utf-8"?>
<!-- Map screen (PC and FT8Call menu bar > Map, Rob 2026-11-24). Map and buttons as the Pages Map page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/js8_frame_bg"
    android:orientation="vertical">

    <!-- Top bar as Settings has it (Rob, 2026-11-26): ← arrow 24 dp in a 48 dp button, the title 22 sp beside it;
         the bar 48 dp tall sideways, 56 dp upright (set in Js8MapFragment). Frame colours kept. -->
    <LinearLayout
        android:id="@+id/js8_map_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/js8_map_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/js8_pref_back"
            android:tint="@color/js8_frame_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:text="Map"
            android:textColor="@color/js8_frame_text"
            android:textSize="22sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp">

        <com.js8call.example.js8ui.Js8MapView
            android:id="@+id/js8_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/js8_map_options"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/js8_shape_blue"
                android:contentDescription="Map options"
                android:padding="9dp"
                android:src="@drawable/js8_map_gear" />

            <TextView
                android:id="@+id/js8_map_zoom_in"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/js8_shape_blue"
                android:gravity="center"
                android:text="+"
                android:textColor="#000000"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/js8_map_zoom_out"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/js8_shape_blue"
                android:gravity="center"
                android:text="−"
                android:textColor="#000000"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/js8_map_fit"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/js8_shape_blue"
                android:gravity="center"
                android:text="Fit"
                android:textColor="#000000"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
