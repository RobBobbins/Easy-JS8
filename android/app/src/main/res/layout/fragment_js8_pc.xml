<?xml version="1.0" encoding="utf-8"?>
<!--
    PC mode (phone sideways, setting "PC"). GENERATED by build-env/gen_pc_layout.py - edit that.
    The JS8Call 3.0.3 window at PC size, 1176 x 714 dp, inside Js8ZoomLayout (pinch zoom, drag).
    Ids are the same as fragment_js8_main.xml.
-->
<com.js8call.example.js8ui.Js8ZoomLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/js8_zoom"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/js8_frame_bg">

<FrameLayout
    android:layout_width="1176dp"
    android:layout_height="714dp"
    android:background="@color/js8_frame_bg">

    <!-- Menu bar -->
    <FrameLayout
        android:layout_width="1060dp"
        android:layout_height="39dp">
        <TextView
            android:id="@+id/js8_menubar_file"
            style="@style/Js8FrameText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="19dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="File" />
        <TextView
            android:id="@+id/js8_menubar_configurations"
            style="@style/Js8FrameText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="77dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Configurations" />
        <TextView
            android:id="@+id/js8_menubar_mode"
            style="@style/Js8FrameText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="210dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Mode" />
        <TextView
            android:id="@+id/js8_menubar_log"
            style="@style/Js8FrameText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="288dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Log" />
        <TextView
            android:id="@+id/js8_menubar_view"
            style="@style/Js8FrameText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="350dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="View" />
        <TextView
            android:id="@+id/js8_menubar_control"
            style="@style/Js8FrameText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="420dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Control" />
        <TextView
            android:id="@+id/js8_menubar_help"
            style="@style/Js8FrameText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="507dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Help" />
    </FrameLayout>

    <!-- Header -->
    <FrameLayout
        android:layout_width="1047dp"
        android:layout_height="88dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="45dp"
        android:background="@color/js8_header_bg">

        <include
            layout="@layout/js8_freq_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp" />

        <include
            layout="@layout/js8_call_clock_block"
            android:layout_width="268dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="328dp"
            android:layout_marginTop="5dp" />

        <include
            layout="@layout/js8_header_buttons"
            android:layout_width="416dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="608dp"
            android:layout_marginTop="12dp" />
    </FrameLayout>

    <!-- Band Activity -->
    <com.js8call.example.js8ui.Js8TableView
        android:id="@+id/js8_band_activity"
        android:layout_width="426dp"
        android:layout_height="211dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="140dp" />

    <!-- Message Window -->
    <include
        layout="@layout/js8_message_window"
        android:layout_width="304dp"
        android:layout_height="137dp"
        android:layout_marginStart="449dp"
        android:layout_marginTop="140dp" />

    <!-- Typing Box -->
    <include
        layout="@layout/js8_typing_box"
        android:layout_width="304dp"
        android:layout_height="67dp"
        android:layout_marginStart="449dp"
        android:layout_marginTop="284dp" />

    <!-- Call Activity -->
    <com.js8call.example.js8ui.Js8TableView
        android:id="@+id/js8_call_activity"
        android:layout_width="303dp"
        android:layout_height="211dp"
        android:layout_marginStart="759dp"
        android:layout_marginTop="140dp" />

    <!-- Buttons -->
    <FrameLayout
        android:layout_width="1062dp"
        android:layout_height="25dp"
        android:layout_marginTop="360dp">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/js8_btn_cq"
            style="@style/Js8Button"
            android:layout_width="90dp"
            android:layout_marginStart="15dp"
            android:text="CQ" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/js8_btn_reply"
            style="@style/Js8Button"
            android:layout_width="92dp"
            android:layout_marginStart="113dp"
            android:enabled="false"
            android:text="REPLY" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/js8_btn_snr"
            style="@style/Js8Button"
            android:layout_width="91dp"
            android:layout_marginStart="212dp"
            android:enabled="false"
            android:text="SNR" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/js8_btn_info"
            style="@style/Js8Button"
            android:layout_width="92dp"
            android:layout_marginStart="310dp"
            android:enabled="false"
            android:text="INFO" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/js8_btn_status"
            style="@style/Js8Button"
            android:layout_width="91dp"
            android:layout_marginStart="409dp"
            android:text="STATUS" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/js8_btn_saved"
            style="@style/Js8Button"
            android:layout_width="90dp"
            android:layout_marginStart="531dp"
            android:text="Saved" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/js8_btn_directed"
            style="@style/Js8Button"
            android:layout_width="92dp"
            android:layout_marginStart="652dp"
            android:enabled="false"
            android:text="Directed" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/js8_btn_deselect"
            style="@style/Js8Button"
            android:layout_width="91dp"
            android:layout_marginStart="751dp"
            android:enabled="false"
            android:text="Deselect" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/js8_btn_send"
            style="@style/Js8Button"
            android:layout_width="91dp"
            android:layout_marginStart="873dp"
            android:enabled="false"
            android:text="Send" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/js8_btn_halt"
            style="@style/Js8Button"
            android:layout_width="90dp"
            android:layout_marginStart="972dp"
            android:text="Halt" />
    </FrameLayout>

    <!-- Waterfall -->
    <include
        layout="@layout/js8_waterfall_block"
        android:layout_width="858dp"
        android:layout_height="277dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="395dp" />

    <!-- Waterfall Controls -->
    <ScrollView
        android:layout_width="116dp"
        android:layout_height="277dp"
        android:layout_marginStart="881dp"
        android:layout_marginTop="395dp">

        <include
            layout="@layout/js8_waterfall_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <com.js8call.example.js8ui.Js8GainSliderView
        android:id="@+id/js8_gain_slider"
        android:layout_width="53dp"
        android:layout_height="277dp"
        android:layout_marginStart="1007dp"
        android:layout_marginTop="395dp" />

    <!-- Status Bar -->
    <include
        layout="@layout/js8_status_bar"
        android:layout_width="1160dp"
        android:layout_height="22dp"
        android:layout_marginStart="7dp"
        android:layout_marginTop="682dp" />

    <!-- Inbox (docked right) -->
    <FrameLayout
        android:layout_width="94dp"
        android:layout_height="633dp"
        android:layout_marginStart="1073dp"
        android:layout_marginTop="39dp">

        <include layout="@layout/js8_inbox_pc" />
    </FrameLayout>
</FrameLayout>
</com.js8call.example.js8ui.Js8ZoomLayout>
