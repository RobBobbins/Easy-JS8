<?xml version="1.0" encoding="utf-8"?>
<!-- Waterfall: CAT button + level meter on the left, ruler over waterfall on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="277dp"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="87dp"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/js8_btn_cat"
            style="@style/Js8HeaderToggleGreen"
            android:layout_width="match_parent"
            android:layout_height="41dp"
            android:text="CAT" />

        <com.js8call.example.js8ui.Js8LevelMeterView
            android:id="@+id/js8_level_meter"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="7dp"
        android:layout_weight="1"
        android:background="#000000"
        android:orientation="vertical">

        <com.js8call.example.js8ui.Js8RulerView
            android:id="@+id/js8_ruler"
            android:layout_width="match_parent"
            android:layout_height="33dp" />

        <com.js8call.example.ui.WaterfallView
            android:id="@+id/js8_waterfall"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
