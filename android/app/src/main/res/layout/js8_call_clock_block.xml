<?xml version="1.0" encoding="utf-8"?>
<!-- Header middle: callsign over UTC clock. The time drift sits right of the callsign in small grey
     text (Rob, 2026-11-03: it did not fit in the clock box); an invisible copy on the left keeps the
     callsign centred. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/js8_clock_drift_pad"
            style="@style/Js8Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:textSize="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/js8_callsign"
            style="@style/Js8Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOCALL"
            android:textSize="@dimen/js8_text_callsign" />

        <!-- Upright only: the band right of the callsign, "VA3OSO   20M" (Rob, 2026-11-05) -->
        <TextView
            android:id="@+id/js8_callsign_band"
            style="@style/Js8Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/js8_text_callsign"
            android:visibility="gone" />

        <TextView
            android:id="@+id/js8_clock_drift"
            style="@style/Js8Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#888888"
            android:textSize="12dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/js8_clock"
        style="@style/Js8Text"
        android:layout_width="268dp"
        android:layout_height="39dp"
        android:background="@drawable/js8_display"
        android:fontFamily="@font/cascadia_mono"
        android:gravity="center"
        android:text="2026 Oct 19 12:45:18"
        android:textColor="@color/js8_display_text"
        android:textSize="@dimen/js8_text_clock"
        android:textStyle="bold" />
</LinearLayout>
