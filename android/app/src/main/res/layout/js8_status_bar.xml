<?xml version="1.0" encoding="utf-8"?>
<!-- Status Bar: Receiving | (blank) | JS8 Normal | Freq | Auto Reply | cycle progress -->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <!-- wrap_content + fillViewport: stretched to the bar width when it fits (spacer pushes the
         progress bar right), natural width and scrollable when it does not -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/js8_status_state"
            style="@style/Js8StatusLabel"
            android:layout_width="173dp"
            android:background="@drawable/js8_status_green"
            android:text="Receiving" />

        <TextView
            android:id="@+id/js8_status_blank"
            style="@style/Js8StatusLabel"
            android:layout_width="173dp"
            android:layout_marginStart="9dp" />

        <TextView
            android:id="@+id/js8_status_mode"
            style="@style/Js8StatusLabel"
            android:layout_width="wrap_content"
            android:layout_marginStart="9dp"
            android:text="JS8 Normal" />

        <TextView
            android:id="@+id/js8_status_freq"
            style="@style/Js8StatusLabel"
            android:layout_width="wrap_content"
            android:layout_marginStart="9dp"
            android:text="Freq: 14.079 500" />

        <TextView
            android:id="@+id/js8_status_autoreply"
            style="@style/Js8StatusLabel"
            android:layout_width="wrap_content"
            android:layout_marginStart="9dp"
            android:text="Auto Reply: On" />

        <!-- Pushes the progress bar to the right edge when there is room (PC mode) -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.js8call.example.js8ui.Js8CycleProgressView
            android:id="@+id/js8_status_progress"
            android:layout_width="200dp"
            android:layout_height="12dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="22dp" />
    </LinearLayout>
</HorizontalScrollView>
