<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/navigation_js8_main">

    <fragment
        android:id="@+id/navigation_js8_main"
        android:name="com.js8call.example.js8ui.Js8MainFragment"
        android:label="Easy JS8" />

    <!-- Settings window (header Settings button): operating settings -->
    <fragment
        android:id="@+id/navigation_js8_settings"
        android:name="com.js8call.example.js8ui.Js8SettingsFragment"
        android:label="Settings">
        <argument
            android:name="window"
            android:defaultValue="settings"
            app:argType="string" />
    </fragment>

    <!-- Station window (Menu > File > Station…): the PC's File > Settings -->
    <fragment
        android:id="@+id/navigation_js8_station"
        android:name="com.js8call.example.js8ui.Js8SettingsFragment"
        android:label="Station">
        <argument
            android:name="window"
            android:defaultValue="station"
            app:argType="string" />
    </fragment>

    <!-- Saved > APRS EMAIL / APRS TXT / APRS GRID / APRS MSG: fills the Typing Box -->
    <fragment
        android:id="@+id/navigation_js8_aprs"
        android:name="com.js8call.example.js8ui.Js8AprsFragment"
        android:label="APRS">
        <argument
            android:name="form"
            android:defaultValue="msg"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/navigation_js8_menu"
        android:name="com.js8call.example.js8ui.Js8MenuFragment"
        android:label="Menu" />

    <fragment
        android:id="@+id/navigation_monitor"
        android:name="com.js8call.example.ui.MonitorFragment"
        android:label="@string/nav_monitor" />

    <fragment
        android:id="@+id/navigation_messages"
        android:name="com.js8call.example.ui.MessagesFragment"
        android:label="@string/nav_messages">
        <action
            android:id="@+id/action_messages_to_conversation"
            app:destination="@id/navigation_conversation" />
    </fragment>

    <fragment
        android:id="@+id/navigation_conversation"
        android:name="com.js8call.example.ui.ConversationFragment"
        android:label="{callsign}">
        <argument
            android:name="callsign"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/navigation_transmit"
        android:name="com.js8call.example.ui.TransmitFragment"
        android:label="@string/nav_transmit" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.js8call.example.ui.SettingsFragment"
        android:label="@string/nav_settings" />
</navigation>
