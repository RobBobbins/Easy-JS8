<?xml version="1.0" encoding="utf-8"?>
<!-- Settings tab: selected = pane color, others = frame color; thin border -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape><solid android:color="@color/js8_cfg_pane" />
            <stroke android:width="1dp" android:color="@color/js8_cfg_tab_border" />
            <corners android:topLeftRadius="3dp" android:topRightRadius="3dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/js8_frame_bg" />
            <stroke android:width="1dp" android:color="@color/js8_cfg_tab_border" />
            <corners android:topLeftRadius="3dp" android:topRightRadius="3dp" /></shape>
    </item>
</selector>
