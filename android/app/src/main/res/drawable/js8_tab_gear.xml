<?xml version="1.0" encoding="utf-8"?>
<!-- Waterfall Controls gear tab, PC and Pages sideways (Rob, 2026-11-24): the window's own colour, a line on the
     top and left only, square corners (Rob, 2026-11-24: no curves); the right and bottom edges are pushed past the view so they have
     no line, the right joining the window, the bottom open to the ruler. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:right="-2dp" android:bottom="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/js8_frame_bg" />
            <stroke android:width="1dp" android:color="@color/js8_list_header_border" />
        </shape>
    </item>
</layer-list>
