<?xml version="1.0" encoding="utf-8"?>
<!-- Settings text box: field color, thin border, lighter underline (Windows 11 style in the capture) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape><solid android:color="@color/js8_cfg_field" /><corners android:radius="3dp" />
            <stroke android:width="1dp" android:color="@color/js8_cfg_field_border" /></shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:gravity="bottom" android:height="1dp">
        <shape><solid android:color="@color/js8_cfg_field_underline" /></shape>
    </item>
</layer-list>
