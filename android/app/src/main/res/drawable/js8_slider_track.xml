<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical|fill_horizontal">
        <shape><solid android:color="@color/js8_slider_empty" /><corners android:radius="3dp" />
            <size android:height="6dp" /></shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical|fill_horizontal">
        <clip><shape><solid android:color="@color/js8_slider_fill" /><corners android:radius="3dp" />
            <size android:height="6dp" /></shape></clip>
    </item>
</layer-list>
